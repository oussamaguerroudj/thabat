ENV=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://thabat:thabat@localhost:5432/thabat

JWT_SECRET=replace-with-a-real-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

AI_PROVIDER_API_KEY=
AI_MODEL_NAME=claude-sonnet-4-6

EMBEDDING_PROVIDER_API_KEY=
EMBEDDING_MODEL_NAME=embed-multilingual-v3.0
EMBEDDING_DIMENSIONS=1024

RATE_LIMIT_PER_MINUTE=60
